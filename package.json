{
  "name": "spark",
  "version": "2.3.0",
  "private": true,
  "description": "Spark — Offline-first gratitude, wins & affirmations app (Play Store offline build).",
  "main": "src/app.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "verify": "bash verify.sh",
    "build:aab": "eas build -p android --profile production",
    "submit:play": "eas submit -p android --profile production"
  },
  "dependencies": {
    "expo": "^52.0.0",
    "expo-sqlite": "~13.0.0",
    "react": "18.3.1",
    "react-native": "0.76.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "typescript": "^5.5.4"
  },
  "jest": {
    "preset": "react-native",
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|expo|expo-sqlite)/)"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
