{
  "cli": { "version": ">= 13.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_NO_DEBUG": "0" }
    },
    "production": {
      "distribution": "store",
      "android": { "gradleCommand": ":app:bundleRelease" },
      "env": { "EXPO_NO_DEBUG": "1" }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "serviceAccountKeyPath": "./android-play-service-account.json"
      }
    }
  }
}
